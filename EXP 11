#include <stdio.h>

int n, e[20][20], vis[20];

void dfs(int s) {
    int i;
    vis[s] = 1;
    for(i=0;i<n;i++)
        if(e[s][i] && !vis[i])
            dfs(i);
}

int main() {
    int i,j;
    printf("Enter number of states: ");
    scanf("%d",&n);
    printf("Enter epsilon transition matrix:\n");
    for(i=0;i<n;i++)
        for(j=0;j<n;j++)
            scanf("%d",&e[i][j]);

    for(i=0;i<n;i++) {
        for(j=0;j<n;j++) vis[j]=0;
        dfs(i);
        printf("E-Closure(q%d) = { ",i);
        for(j=0;j<n;j++)
            if(vis[j]) printf("q%d ",j);
        printf("}\n");
    }
    return 0;
}
